            <key>IsRemovable</key>
            <true/>
            <!-- Tên ứng dụng hiển thị dưới Icon trên màn hình chính -->
            <key>Label</key>
            <string>HeadLock C28H</string>
            <key>PayloadDescription</key>
            <string>HeadLock C28H System iOS</string>
            <key>PayloadDisplayName</key>
            <string>HeadLock C28H WebClip</string>
