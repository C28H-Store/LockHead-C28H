            <string>com.c28h.headlock.webclip</string>
            <key>PayloadOrganization</key>
            <string>C28H Store</string>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadUUID</key>
            <string>8B8C7A1E-4F35-4E8A-9C28-000000000001</string>
            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>URL</key>
            <string>https://c28h-store.github.io/APP-Aimlock-By-C28H/index.html</string>
        </dict>
    </array>

    <key>PayloadDescription</key>
